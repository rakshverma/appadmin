FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
ARG REACT_APP_API_BASE_URL=/api
ARG REACT_APP_ADMIN_API_BASE_URL=/admin-api
ARG REACT_APP_UPLOAD_URL=/uploads
ARG REACT_APP_ADMIN_BASENAME=
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL
ENV REACT_APP_ADMIN_API_BASE_URL=$REACT_APP_ADMIN_API_BASE_URL
ENV REACT_APP_UPLOAD_URL=$REACT_APP_UPLOAD_URL
ENV REACT_APP_ADMIN_BASENAME=$REACT_APP_ADMIN_BASENAME
RUN npm run build

FROM nginx:1.27-alpine

ENV NGINX_PORT=8080
ENV BACKEND_ORIGIN=http://node-server:3000

COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 8080
